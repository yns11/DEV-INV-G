# =============================================================================
# Développement local — copiez en `.env` et adaptez.
# Sur Databricks Apps, ces valeurs viennent des ressources attachées et des
# variables d'environnement de l'app : ce fichier n'est jamais déployé.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
INV_ENV=local
INV_LOG_LEVEL=INFO

# --- Lakebase / PostgreSQL local ---------------------------------------------
# Sur la plateforme, ces variables sont injectées par la ressource « database ».
# Chemin de ressource de la branche Lakebase, utilisé pour retrouver l'endpoint
# dont dépend le credential. Inutile en local : PGPASSWORD court-circuite tout
# le mécanisme de jeton.
# INV_LAKEBASE_BRANCH=projects/inventaire/branches/production
# INV_LAKEBASE_ENDPOINT=projects/inventaire/branches/production/endpoints/primary

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=inventaire
PGUSER=postgres
PGPASSWORD=inventaire
PGSSLMODE=disable
INV_PG_SCHEMA=inventory

# --- Databricks (facultatif en local) ----------------------------------------
# Sans ces valeurs, l'application démarre et signale les fonctions indisponibles
# (lectures Delta, extraction IA des scans) plutôt que d'échouer.
# DATABRICKS_HOST=https://votre-workspace.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=
# INV_LLM_ENDPOINT=databricks-claude-opus-4-8

# Cadrage de l'assistant de campagne. Un seul profil est livré (« etendu » :
# le dossier complet de la campagne, raisonnement libre, chiffres du dossier).
# La variable existe pour qu'en ajouter un autre soit un redémarrage, pas une
# livraison de code — voir app/inventory/ai/assistant.py.
INV_ASSISTANT_PROFILE=etendu

# --- Lecture des scans --------------------------------------------------------
# Une pile de cent feuilles fait deux cents pages. Aucune de ces valeurs n'a
# d'optimum universel : elles dépendent du débit réel de l'endpoint. Voir
# docs/03-guide-deploiement.md §8.2 bis.
#
# Endpoint vision dédié. Vide = INV_LLM_ENDPOINT. Transcrire des chiffres
# manuscrits n'appelle aucun raisonnement ; le payer cent fois par pile, si.
INV_SCAN_LLM_ENDPOINT=
INV_SCAN_MAX_WORKERS=4
INV_SCAN_MAX_PAGES=250
INV_SCAN_ROUTING_BATCH=12
INV_SCAN_DPI=150

# --- Source ERP ---------------------------------------------------------------
# Tables silver Unity Catalog lues par « Lire depuis l'ERP ». Configurables pour
# qu'un renommage côté plateforme de données ne demande pas de livraison ici.
# La lecture passe par l'entrepôt SQL attaché (DATABRICKS_WAREHOUSE_ID) :
# sans entrepôt, l'option est proposée désactivée et l'écran dit pourquoi.
INV_ERP_SCHEMA=emotors_data_champions.silver_erp_ye
INV_ERP_ITEMS_TABLE=silver_base_article
INV_ERP_BOM_TABLE=silver_bom
# Photo quotidienne du stock physique, une ligne par article × entrepôt ×
# emplacement. L'application en lit la date la plus récente, et elle seule.
INV_ERP_STOCK_TABLE=stock_snapshot
# Mouvements de stock, à la maille référence × jour, une colonne par flux.
INV_ERP_MOVEMENTS_TABLE=mouvements

# --- Unity Catalog ------------------------------------------------------------
INV_UC_CATALOG=emotors_data_champions
INV_UC_SCHEMA=inventory
INV_UC_VOLUME=inventory_evidence

# Où sont archivés les scans et les fichiers chargés.
#   volume   : dans le volume Unity Catalog ci-dessus. C'est le bon endroit —
#              il se parcourt depuis l'espace de travail — mais il exige trois
#              GRANT au service principal de l'App, dont USE CATALOG que seul
#              le propriétaire du catalogue peut accorder.
#   lakebase : dans la base de l'application (table evidence_blob, migration
#              022). Aucun administrateur n'est nécessaire. La bascule est sûre
#              dans les deux sens : ce qui est déjà archivé reste lisible.
INV_EVIDENCE_STORE=volume

# --- Règles métier ------------------------------------------------------------
INV_GENERIC_WAREHOUSE=B06VRAC
INV_GENERIC_LOCATION=GENERIQUE

# --- Garde-fous ---------------------------------------------------------------
INV_MAX_IMPORT_ROWS=200000
INV_MAX_UPLOAD_BYTES=67108864
